# 会场精灵 - 环境配置模板
# 复制此文件为 .env 并按实际环境修改

# ============================================
# 数据库配置
# ============================================
# Docker Compose 默认值：
# mysql+pymysql://shai:shai123456@mysql:3306/event_assistant?charset=utf8mb4
# 传统部署请改为 localhost 和实际密码
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/event_assistant?charset=utf8mb4

# Docker Compose 专用（可选，用于覆盖默认数据库）
DB_ROOT_PASSWORD=root123456
DB_USER=shai
DB_PASSWORD=shai123456
DB_NAME=event_assistant
DB_HOST=localhost
DB_PORT=3306

# ============================================
# JWT 密钥（生产环境请使用强随机字符串）
# ============================================
SECRET_KEY=your-secret-key-change-in-production

# ============================================
# AI 服务配置（通义千问）
# ============================================
DASHSCOPE_API_KEY=your-dashscope-api-key
AI_MODEL=qwen-plus

# ============================================
# 高德地图配置
# ============================================
AMAP_API_KEY=your-amap-api-key

# ============================================
# 后端运行配置
# ============================================
DEBUG=False
PORT=8000

# CORS 允许源（多个用逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# 前端环境变量（构建时注入）
# ============================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_AMAP_KEY=your-amap-key
VITE_AMAP_SECURITY_CODE=your-amap-security-code
